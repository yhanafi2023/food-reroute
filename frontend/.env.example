# Copy to frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000
# true: run the UI against lib/mock.ts without the backend
NEXT_PUBLIC_USE_MOCKS=false
# Optional: Mapbox tiles for the map (public token, pk.*). Without it the map uses OpenStreetMap tiles.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional: URL encoded in the /qr page (defaults to the current site)
NEXT_PUBLIC_SITE_URL=
