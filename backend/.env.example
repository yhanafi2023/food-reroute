# Copy to backend/.env. Never commit backend/.env.

# SQLite locally. Supabase: the transaction pooler URL (port 6543) for the app; run migrations with the
# direct URL (port 5432): DATABASE_URL=... alembic upgrade head
DATABASE_URL=sqlite:///./foodflow.db
# Required (32+ random characters) whenever DEMO_MODE=false or on Vercel:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_HOURS=24
# true: seed fictional demo accounts and history; demo accounts sign in with the demo password in app/seed.py.
# false in production: the schema then comes only from migrations, and demo accounts cannot sign in.
DEMO_MODE=true
TIMEZONE=America/New_York
CORS_ORIGINS=http://localhost:3000
# Optional regex for extra allowed origins, e.g. Vercel previews: https://food-reroute-[a-z0-9-]+\.vercel\.app
CORS_ORIGIN_REGEX=
# In-process job loop (defaults to off on Vercel). Serverless: call /internal/jobs/run every minute instead,
# with "Authorization: Bearer <CRON_SECRET>". Empty CRON_SECRET turns that endpoint off.
RUN_SCHEDULER=true
SCHEDULER_SECONDS=30
CRON_SECRET=

# Supabase Auth (optional): Supabase access tokens are accepted alongside FoodFlow's own sign-in, linked on first
# use to the FoodFlow account with the same Supabase-confirmed email. Project Settings -> API Keys.
# The secret key also authorizes /internal/jobs/run when sent as "apikey: <key>" (pg_net). Never expose it.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Defaults to <SUPABASE_URL>/auth/v1/.well-known/jwks.json. Needs JWT signing keys (ES256/RS256), not the legacy secret.
SUPABASE_JWKS_URL=
# SERVERLESS defaults to true on Vercel (it sets VERCEL=1): no connection pool per instance, trust Vercel's
# x-real-ip for the login throttle. Leave it unset unless you need to override that.
# SERVERLESS=true

# Teammate services. Empty: use the in-process modules. Failures fall back and are flagged estimated=true.
ROUTING_SERVICE_URL=
ALLOCATION_SERVICE_URL=
SERVICE_TIMEOUT_SECONDS=3

# Notifications: console always; email with SMTP_HOST; SMS only with all three Twilio values.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FoodFlow <no-reply@example.com>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Assumptions (see app/assumptions.py and GET /config/assumptions)
LOAD_WINDOW_MIN=5
NO_SHOW_GRACE_MIN=15
AV_CAPACITY_MEALS=60
AV_SIM_FLEET_SIZE=3
ROBOT_MAX_MI=2.0
ROBOT_CAPACITY_MEALS=20
MEAL_VALUE_USD=3.0

# Map routes: mapbox | osrm | offline. Unset: mapbox with a token, else osrm; failures fall back to offline.
ROUTING_PROVIDER=
MAPBOX_ACCESS_TOKEN=
OSRM_URL=https://router.project-osrm.org
