# Copy to backend/.env and fill in. Never commit backend/.env.

# SQLite by default. For Postgres (Render): postgresql://user:pass@host:5432/foodflow (pip install psycopg2-binary)
DATABASE_URL=sqlite:///./foodflow.db

# Long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_HOURS=24

# true: seed demo data when the database is empty; routing is offline unless a Mapbox token is set
DEMO_MODE=true

# Comma separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# Routing: mapbox | osrm | offline. Unset: mapbox if MAPBOX_ACCESS_TOKEN is set, else offline in demo mode.
ROUTING_PROVIDER=
MAPBOX_ACCESS_TOKEN=
OSRM_URL=https://router.project-osrm.org

# Community value per meal in USD. An ASSUMPTION shown as an estimate; replace with a sourced figure.
MEAL_VALUE_USD=3.0

# Optional: where the surplus model is saved (trained automatically if missing)
SURPLUS_MODEL_PATH=
